/* pages/login/login.wxss */
.container {
  min-height: 100vh;
  padding: 60rpx 40rpx;
  background: linear-gradient(180deg, #fef2f2 0%, #f5f6fa 40%);
  box-sizing: border-box;
}

/* Logo区域 */
.logo-section {
  text-align: center;
  padding: 80rpx 0 60rpx;
}

.logo-icon {
  font-size: 140rpx;
  margin-bottom: 24rpx;
}

.logo-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #e74c3c;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.logo-subtitle {
  font-size: 28rpx;
  color: #666;
}

/* 登录权益区域 */
.benefit-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.benefit-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 24rpx;
}

.benefit-list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.benefit-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
}

.benefit-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.benefit-text {
  font-size: 22rpx;
  color: #666;
  text-align: center;
  white-space: nowrap;
}

/* 登录按钮区域 */
.login-section {
  margin-bottom: 32rpx;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  transition: all 0.3s;
}

.login-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.login-btn.wechat {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35);
}

.btn-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

/* 游客入口 */
.guest-section {
  text-align: center;
  margin-bottom: 60rpx;
}

.guest-link {
  font-size: 28rpx;
  color: #666;
  text-decoration: underline;
}


/* Loading遮罩 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-content {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 48rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f0f0f0;
  border-top-color: #07c160;
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-content text {
  font-size: 28rpx;
  color: #666;
}
