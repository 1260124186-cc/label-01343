<!--pages/login/login.wxml-->
<view class="container">
  <!-- Logo区域 -->
  <view class="logo-section">
    <view class="logo-icon">🛡️</view>
    <view class="logo-title">校园反诈卫士</view>
    <view class="logo-subtitle">守护校园安全，远离网络诈骗</view>
  </view>

  <!-- 登录权益展示 -->
  <view class="benefit-section">
    <view class="benefit-title">登录后可使用</view>
    <view class="benefit-list">
      <view class="benefit-item">
        <text class="benefit-icon">✏️</text>
        <text class="benefit-text">反诈知识测试</text>
      </view>
      <view class="benefit-item">
        <text class="benefit-icon">📍</text>
        <text class="benefit-text">校园求助点位</text>
      </view>
      <view class="benefit-item">
        <text class="benefit-icon">🏫</text>
        <text class="benefit-text">求助渠道</text>
      </view>
      <view class="benefit-item">
        <text class="benefit-icon">📊</text>
        <text class="benefit-text">记录保存</text>
      </view>
    </view>
  </view>

  <!-- 登录按钮区域 -->
  <view class="login-section">
    <view class="login-btn wechat" bindtap="onWechatLogin">
      <text class="btn-icon">💬</text>
      <text>微信快捷登录</text>
    </view>
  </view>

  <!-- 游客入口 -->
  <view class="guest-section">
    <text class="guest-link" bindtap="onGuestMode">暂不登录，以游客身份浏览</text>
  </view>
</view>

<!-- Loading遮罩 -->
<view class="loading-mask" wx:if="{{isLoading}}">
  <view class="loading-content">
    <view class="loading-spinner"></view>
    <text>登录中...</text>
  </view>
</view>
