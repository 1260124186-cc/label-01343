/* pages/quiz/quiz.wxss */
.container {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ========== 开始界面 ========== */
.start-page {
  padding: 40rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #f3e8fd 0%, #f5f6fa 30%);
  min-height: 100vh;
  box-sizing: border-box;
}

.start-header {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.start-icon {
  font-size: 160rpx;
  margin-bottom: 36rpx;
  filter: drop-shadow(0 16rpx 32rpx rgba(155, 89, 182, 0.25));
}

.start-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.start-subtitle {
  font-size: 30rpx;
  color: #666;
}

.category-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.category-card {
  padding: 24rpx 12rpx;
  text-align: center;
  background: #f8f9fa;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.category-card.active {
  background: linear-gradient(135deg, #f3e8fd 0%, #e5d1f9 100%);
  border-color: #9b59b6;
  box-shadow: 0 4rpx 16rpx rgba(155, 89, 182, 0.2);
}

.category-card:active:not(.active) {
  background: #f0f0f0;
  transform: scale(0.96);
}

.category-name {
  font-size: 26rpx;
  color: #555;
  font-weight: 500;
  white-space: nowrap;
}

.category-card.active .category-name {
  color: #8e44ad;
  font-weight: 700;
}

.start-tips {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.tip-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #555;
}

.tip-item + .tip-item {
  border-top: 1rpx solid #f0f0f0;
}

.tip-icon {
  margin-right: 20rpx;
  font-size: 36rpx;
}

.start-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 108rpx;
  background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);
  color: #ffffff;
  border-radius: 54rpx;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 12rpx 32rpx rgba(155, 89, 182, 0.4);
  transition: all 0.3s;
}

.start-btn:active {
  transform: scale(0.96);
  box-shadow: 0 8rpx 24rpx rgba(155, 89, 182, 0.5);
}

/* 登录区域 */
.login-section {
  text-align: center;
}

.login-tip {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 108rpx;
  background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
  color: #ffffff;
  border-radius: 54rpx;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 12rpx 32rpx rgba(52, 152, 219, 0.4);
  transition: all 0.3s;
}

.login-btn:active {
  transform: scale(0.96);
  box-shadow: 0 8rpx 24rpx rgba(52, 152, 219, 0.5);
}

/* ========== 测试界面 ========== */
.quiz-page {
  padding: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #f3e8fd 0%, #f5f6fa 15%);
  min-height: 100vh;
  box-sizing: border-box;
}

.progress-bar {
  height: 12rpx;
  background: #e0e0e0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #9b59b6 0%, #e74c3c 100%);
  border-radius: 6rpx;
  transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.progress-text {
  text-align: center;
  margin-bottom: 28rpx;
  font-size: 28rpx;
}

.progress-text .current {
  color: #9b59b6;
  font-size: 44rpx;
  font-weight: 800;
}

.progress-text .total {
  color: #999;
}

.question-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 32rpx rgba(0, 0, 0, 0.08);
}

.question-type {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 12rpx;
}

.type-tag,
.difficulty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.type-tag.single {
  background: linear-gradient(135deg, #e8f4fd 0%, #d1e9f9 100%);
  color: #2980b9;
}

.type-tag.multiple {
  background: linear-gradient(135deg, #f3e8fd 0%, #e5d1f9 100%);
  color: #8e44ad;
}

.type-tag.judge {
  background: linear-gradient(135deg, #e8fdf3 0%, #d1f9e5 100%);
  color: #229954;
}

.difficulty.easy {
  background: #e8fdf3;
  color: #27ae60;
}

.difficulty.medium {
  background: #fef3e2;
  color: #e67e22;
}

.difficulty.hard {
  background: #fde8e8;
  color: #c0392b;
}

.question-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.7;
  margin-bottom: 32rpx;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
  border: 3rpx solid transparent;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.option-item:active:not(.correct):not(.wrong) {
  transform: scale(0.98);
}

.option-item.selected {
  background: linear-gradient(135deg, #e8f4fd 0%, #d1e9f9 100%);
  border-color: #3498db;
  box-shadow: 0 4rpx 16rpx rgba(52, 152, 219, 0.2);
}

.option-item.correct {
  background: linear-gradient(135deg, #e8fdf3 0%, #d1f9e5 100%);
  border-color: #27ae60;
}

.option-item.wrong {
  background: linear-gradient(135deg, #fde8e8 0%, #fcd5d5 100%);
  border-color: #e74c3c;
}

.option-letter {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #e0e0e0;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  margin-right: 20rpx;
  flex-shrink: 0;
  transition: all 0.25s;
}

.option-item.selected .option-letter {
  background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(52, 152, 219, 0.3);
}

.option-item.correct .option-letter {
  background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(39, 174, 96, 0.3);
}

.option-item.wrong .option-letter {
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(231, 76, 60, 0.3);
}

.option-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
}

.option-status {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.status-icon {
  font-size: 36rpx;
  font-weight: bold;
}

.status-icon.correct {
  color: #27ae60;
}

.status-icon.wrong {
  color: #e74c3c;
}

/* 答案解析 */
.analysis-section {
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 2rpx dashed #e0e0e0;
  animation: fadeIn 0.4s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.analysis-header {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.analysis-header.correct {
  color: #27ae60;
}

.analysis-header.wrong {
  color: #e74c3c;
}

.analysis-content {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
}

.correct-answer {
  font-size: 28rpx;
  color: #27ae60;
  font-weight: 600;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.analysis-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

/* 操作按钮 */
.action-buttons {
  padding: 20rpx 0;
}

.submit-btn,
.next-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 104rpx;
  border-radius: 52rpx;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  transition: all 0.3s;
}

.submit-btn:active,
.next-btn:active {
  transform: scale(0.96);
}

.submit-btn {
  background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(52, 152, 219, 0.35);
}

.next-btn {
  background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(39, 174, 96, 0.35);
}

/* ========== 结果界面 ========== */
.result-page {
  padding: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #f3e8fd 0%, #f5f6fa 25%);
  min-height: 100vh;
  box-sizing: border-box;
}

.result-header {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 32rpx rgba(0, 0, 0, 0.08);
}

.score-circle {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  position: relative;
}

.score-circle::before {
  content: '';
  position: absolute;
  inset: -12rpx;
  border-radius: 50%;
  border: 6rpx dashed rgba(255, 255, 255, 0.3);
}

.score-circle.excellent {
  background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
  box-shadow: 0 12rpx 40rpx rgba(39, 174, 96, 0.4);
}

.score-circle.good {
  background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
  box-shadow: 0 12rpx 40rpx rgba(243, 156, 18, 0.4);
}

.score-circle.bad {
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
  box-shadow: 0 12rpx 40rpx rgba(231, 76, 60, 0.4);
}

.score-number {
  font-size: 80rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
}

.score-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.result-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 36rpx;
}

.result-stats {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 800;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.stat-item.correct .stat-value {
  color: #27ae60;
}

.stat-item.wrong .stat-value {
  color: #e74c3c;
}

.stat-label {
  font-size: 26rpx;
  color: #999;
}

/* 错题回顾 */
.wrong-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.wrong-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.wrong-item {
  padding: 24rpx;
  background: linear-gradient(135deg, #fff5f5 0%, #fee2e2 100%);
  border-radius: 20rpx;
  border-left: 10rpx solid #e74c3c;
}

.wrong-question {
  font-size: 30rpx;
  color: #1a1a1a;
  line-height: 1.6;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.wrong-answer {
  display: flex;
  gap: 28rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.your-answer {
  color: #e74c3c;
  font-weight: 600;
}

.right-answer {
  color: #27ae60;
  font-weight: 600;
}

.wrong-analysis {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e0e0e0;
}

/* 结果操作按钮 */
.result-buttons {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
}

.restart-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 28rpx rgba(155, 89, 182, 0.35);
  transition: all 0.3s;
}

.restart-btn:active {
  transform: scale(0.96);
}

.result-buttons .share-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  background: #ffffff;
  border: 3rpx solid #9b59b6;
  color: #9b59b6;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 700;
  padding: 0;
  margin: 0;
  transition: all 0.3s;
}

.result-buttons .share-btn::after {
  border: none;
}

.result-buttons .share-btn:active {
  background: #f3e8fd;
  transform: scale(0.96);
}

.result-buttons .share-btn .share-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}
