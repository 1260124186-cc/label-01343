/* pages/cases/cases.wxss */
.container {
  padding: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #fef2f2 0%, #f5f6fa 20%);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部提示 */
.top-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #fff8e1 0%, #ffecb3 100%);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  color: #8b6914;
  font-weight: 600;
  text-align: center;
}

/* 分类滚动 */
.category-scroll {
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  padding: 8rpx 0;
  gap: 16rpx;
}

.category-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 36rpx;
  background: #ffffff;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid transparent;
}

.category-item.active {
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(231, 76, 60, 0.3);
  border-color: transparent;
}

.category-item:not(.active):active {
  background: #f8f8f8;
  transform: scale(0.96);
}

/* 案例列表 */
.case-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.case-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.case-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.case-image-wrap {
  position: relative;
  width: 100%;
  height: 320rpx;
  overflow: hidden;
}

.case-image {
  width: 100%;
  height: 100%;
  transition: transform 0.3s;
}

.case-card:active .case-image {
  transform: scale(1.02);
}

.danger-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  backdrop-filter: blur(10rpx);
}

.danger-badge.high {
  background: rgba(231, 76, 60, 0.95);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(231, 76, 60, 0.4);
}

.danger-badge.medium {
  background: rgba(243, 156, 18, 0.95);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(243, 156, 18, 0.4);
}

.case-info {
  padding: 28rpx;
}

.case-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.case-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #fde8e8 0%, #fcd5d5 100%);
  color: #c0392b;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.case-count {
  font-size: 24rpx;
  color: #999;
}

.case-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.case-summary {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 24rpx;
}

.case-tips {
  background: linear-gradient(135deg, #fff5f5 0%, #fee2e2 100%);
  border-left: 8rpx solid #e74c3c;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border-radius: 0 16rpx 16rpx 0;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  font-size: 26rpx;
  color: #c0392b;
  line-height: 1.8;
  font-weight: 500;
}

.tip-item + .tip-item {
  margin-top: 8rpx;
}

.tip-dot {
  margin-right: 12rpx;
  font-weight: bold;
  font-size: 28rpx;
}

.case-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.case-date {
  font-size: 24rpx;
  color: #bbb;
}

.view-detail {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #e74c3c;
  font-weight: 600;
}

.arrow-icon {
  font-size: 28rpx;
  margin-left: 8rpx;
  font-weight: bold;
}

/* 底部提示 */
.bottom-tip {
  text-align: center;
  padding: 48rpx 0;
  color: #ccc;
  font-size: 26rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-state text {
  font-size: 30rpx;
  color: #999;
}
