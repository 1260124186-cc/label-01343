/* pages/caseDetail/caseDetail.wxss */
.container {
  padding-bottom: 40rpx;
  background: #f5f6fa;
}

/* 头部图片 */
.header-image {
  position: relative;
  width: 100%;
  height: 440rpx;
  overflow: hidden;
}

.header-image image {
  width: 100%;
  height: 100%;
}

.header-image::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
}

.danger-badge {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  padding: 14rpx 28rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  z-index: 10;
}

.danger-badge.high {
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(231, 76, 60, 0.5);
}

.danger-badge.medium {
  background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(243, 156, 18, 0.5);
}

/* 标题区域 */
.title-section {
  padding: 32rpx 28rpx;
  background: #ffffff;
  margin-top: -40rpx;
  border-radius: 32rpx 32rpx 0 0;
  position: relative;
  z-index: 20;
}

.case-tag {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, #fde8e8 0%, #fcd5d5 100%);
  color: #c0392b;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.case-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1a1a1a;
  line-height: 1.35;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.case-meta {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999;
}

.meta-divider {
  margin: 0 20rpx;
  color: #ddd;
}

/* 通用区块样式 */
.summary-section,
.video-section,
.content-section,
.tips-section,
.help-section {
  padding: 28rpx;
  background: #ffffff;
  margin-top: 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.section-title.warning {
  color: #c0392b;
}

.title-icon {
  width: 10rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #3498db 0%, #2980b9 100%);
  border-radius: 5rpx;
  margin-right: 16rpx;
}

.title-icon.video {
  background: linear-gradient(180deg, #9b59b6 0%, #8e44ad 100%);
}

.title-icon.warning {
  background: linear-gradient(180deg, #e74c3c 0%, #c0392b 100%);
}

.title-icon.help {
  background: linear-gradient(180deg, #27ae60 0%, #229954 100%);
}

/* 摘要内容 */
.summary-content {
  font-size: 30rpx;
  color: #555;
  line-height: 1.9;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #f1f3f4 100%);
  border-radius: 16rpx;
  border-left: 8rpx solid #3498db;
}

/* 视频区域 */
.case-video {
  width: 100%;
  height: 420rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

/* 详细内容 */
.content-text {
  font-size: 30rpx;
  color: #333;
  line-height: 2.1;
  white-space: pre-wrap;
  letter-spacing: 0.5rpx;
}

/* 防范要点 */
.tips-section {
  background: linear-gradient(135deg, #fff5f5 0%, #fee2e2 100%);
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 1.7;
}

.tip-icon {
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: bold;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(231, 76, 60, 0.3);
}

/* 求助通道 */
.help-buttons {
  display: flex;
  gap: 20rpx;
}

.help-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 16rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s;
}

.help-btn .btn-text {
  white-space: nowrap;
}

.help-btn:active {
  transform: scale(0.96);
}

.help-btn .btn-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.help-btn.police {
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(231, 76, 60, 0.35);
}

.help-btn.antifraud {
  background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(52, 152, 219, 0.35);
}

/* 分享提示 */
.share-tip {
  padding: 36rpx 28rpx;
  margin-top: 20rpx;
}

.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  background: #ffffff;
  border: 3rpx solid #3498db;
  color: #3498db;
  padding: 28rpx 48rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s;
  white-space: nowrap;
  box-sizing: border-box;
}

.share-btn::after {
  border: none;
}

.share-btn:active {
  background: #e8f4fd;
  transform: scale(0.98);
}

.share-btn .share-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}
