/* pages/guideDetail/guideDetail.wxss */
.container {
  padding-bottom: 40rpx;
  background: #f5f6fa;
}

/* 头部信息 */
.header-section {
  padding: 36rpx 28rpx;
  background: linear-gradient(180deg, #e8f4fd 0%, #ffffff 100%);
  position: relative;
}

.header-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #3498db 0%, #2980b9 50%, #27ae60 100%);
}

.guide-tag {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, #e8f4fd 0%, #d1e9f9 100%);
  color: #2980b9;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.guide-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1a1a1a;
  line-height: 1.35;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.guide-summary {
  font-size: 30rpx;
  color: #555;
  line-height: 1.8;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(52, 152, 219, 0.08);
  border-radius: 16rpx;
  border-left: 8rpx solid #3498db;
}

.guide-meta {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999;
}

.meta-divider {
  margin: 0 20rpx;
  color: #ddd;
}

/* 内容区域 */
.content-section {
  padding: 28rpx;
  background: #ffffff;
  margin-top: 20rpx;
}

/* 二级标题 */
.h2-title {
  display: flex;
  align-items: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  padding: 28rpx 0 20rpx;
  margin-top: 16rpx;
}

.title-bar {
  width: 10rpx;
  height: 40rpx;
  background: linear-gradient(180deg, #3498db 0%, #2980b9 100%);
  border-radius: 5rpx;
  margin-right: 20rpx;
}

/* 三级标题 */
.h3-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  padding: 20rpx 0 16rpx;
  padding-left: 30rpx;
  border-left: 6rpx solid #e0e0e0;
  margin-left: 4rpx;
}

/* 对勾列表 */
.check-item {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 24rpx;
  background: linear-gradient(135deg, #e8fdf3 0%, #d1f9e5 100%);
  margin: 12rpx 0;
  border-radius: 16rpx;
  border-left: 8rpx solid #27ae60;
}

.check-icon {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(39, 174, 96, 0.3);
}

.check-item text {
  font-size: 30rpx;
  color: #1a1a1a;
  line-height: 1.7;
  font-weight: 600;
}

/* 警告提示 */
.warning-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #fff8e1 0%, #ffecb3 100%);
  margin: 12rpx 0;
  border-radius: 16rpx;
  border-left: 8rpx solid #f39c12;
}

.warning-icon {
  margin-right: 16rpx;
  flex-shrink: 0;
  font-size: 32rpx;
}

.warning-item text {
  font-size: 30rpx;
  color: #1a1a1a;
  line-height: 1.7;
  font-weight: 500;
}

/* 列表项 */
.list-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  padding-left: 8rpx;
}

.list-dot {
  width: 14rpx;
  height: 14rpx;
  background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
  border-radius: 50%;
  margin-right: 20rpx;
  margin-top: 18rpx;
  flex-shrink: 0;
}

.list-item text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.9;
}

/* 数字列表 */
.number-item {
  padding: 12rpx 0;
  font-size: 30rpx;
  color: #333;
  line-height: 1.9;
  padding-left: 8rpx;
}

/* 空行 */
.empty-line {
  height: 20rpx;
}

/* 普通文本 */
.text-item {
  font-size: 30rpx;
  color: #333;
  line-height: 2;
  padding: 6rpx 0;
}

/* 关键词区域 */
.keywords-section {
  padding: 28rpx;
  background: #ffffff;
  margin-top: 20rpx;
}

.section-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.keywords-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.keyword-tag {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 24rpx;
  background: linear-gradient(135deg, #f5f6fa 0%, #eef0f5 100%);
  color: #555;
  border-radius: 24rpx;
  font-size: 26rpx;
  transition: all 0.2s;
}

.keyword-tag:active {
  background: linear-gradient(135deg, #e8f4fd 0%, #d1e9f9 100%);
  color: #2980b9;
}

/* 求助通道 */
.help-section {
  padding: 28rpx;
  background: #ffffff;
  margin-top: 20rpx;
}

.help-buttons {
  display: flex;
  gap: 20rpx;
}

.help-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 16rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s;
}

.help-btn:active {
  transform: scale(0.96);
}

.help-btn .btn-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.help-btn .btn-text {
  white-space: nowrap;
}

.help-btn.police {
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(231, 76, 60, 0.35);
}

.help-btn.antifraud {
  background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(52, 152, 219, 0.35);
}

/* 分享按钮 */
.share-section {
  padding: 36rpx 28rpx;
}

.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  background: #ffffff;
  border: 3rpx solid #3498db;
  color: #3498db;
  padding: 28rpx 48rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s;
  white-space: nowrap;
  box-sizing: border-box;
}

.share-btn::after {
  border: none;
}

.share-btn:active {
  background: #e8f4fd;
  transform: scale(0.98);
}

.share-btn .share-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}
