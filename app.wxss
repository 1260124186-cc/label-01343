/**app.wxss - 全局样式**/

/* 主题色变量 */
page {
  --primary-color: #e74c3c;
  --primary-dark: #c0392b;
  --primary-light: #fde8e8;
  --warning-color: #f39c12;
  --warning-light: #fef3e2;
  --success-color: #27ae60;
  --success-light: #e8fdf3;
  --info-color: #3498db;
  --info-light: #e8f4fd;
  --purple-color: #9b59b6;
  --purple-light: #f3e8fd;
  --text-primary: #1a1a1a;
  --text-secondary: #666666;
  --text-hint: #999999;
  --text-disabled: #cccccc;
  --bg-page: #f5f6fa;
  --bg-card: #ffffff;
  --border-color: #eef0f5;
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  
  /* 全局页面背景，避免跳转时白色闪烁 */
  background-color: #f5f6fa;
  min-height: 100vh;
  
  background-color: var(--bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* 容器 */
.container {
  padding: 24rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* 现代卡片 */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-md);
  position: relative;
  overflow: hidden;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary-color), var(--warning-color));
  opacity: 0;
  transition: opacity 0.3s;
}

.card:active::before {
  opacity: 1;
}

/* 玻璃态效果 */
.glass {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

/* 渐变背景 */
.gradient-danger {
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
}

.gradient-warning {
  background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
}

.gradient-info {
  background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
}

.gradient-success {
  background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
}

.gradient-purple {
  background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);
}

/* 文字颜色 */
.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-hint { color: var(--text-hint); }
.text-danger { color: var(--primary-color); }
.text-warning { color: var(--warning-color); }
.text-success { color: var(--success-color); }
.text-info { color: var(--info-color); }
.text-white { color: #ffffff; }

/* 现代按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.btn::after {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.2);
  opacity: 0;
  transition: opacity 0.3s;
}

.btn:active::after {
  opacity: 1;
}

.btn-danger {
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(231, 76, 60, 0.35);
}

.btn-info {
  background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(52, 152, 219, 0.35);
}

.btn-success {
  background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(39, 174, 96, 0.35);
}

.btn-outline {
  background: transparent;
  border: 3rpx solid var(--primary-color);
  color: var(--primary-color);
}

.btn-outline:active {
  background: var(--primary-light);
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.tag-danger {
  background: var(--primary-light);
  color: var(--primary-color);
}

.tag-warning {
  background: var(--warning-light);
  color: var(--warning-color);
}

.tag-info {
  background: var(--info-light);
  color: var(--info-color);
}

.tag-success {
  background: var(--success-light);
  color: var(--success-color);
}

.tag-purple {
  background: var(--purple-light);
  color: var(--purple-color);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--border-color), transparent);
  margin: 24rpx 0;
}

/* Flex 布局 */
.flex { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-start { display: flex; align-items: flex-start; }
.flex-column { display: flex; flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }

/* 文字截断 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.ellipsis-3 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  75% { transform: translateX(10rpx); }
}

.animate-fadeIn {
  animation: fadeIn 0.4s ease-out;
}

.animate-pulse {
  animation: pulse 2s infinite;
}

/* 警示横幅 */
.warning-banner {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #fff8e1 0%, #ffecb3 100%);
  border-radius: var(--radius-md);
  border-left: 8rpx solid var(--warning-color);
  margin-bottom: 24rpx;
}

.warning-banner .icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.warning-banner .text {
  font-size: 26rpx;
  color: #8b6914;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-state .icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-state .title {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-state .desc {
  font-size: 26rpx;
  color: var(--text-hint);
}
