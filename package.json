{
  "name": "campus-anti-fraud-miniprogram",
  "version": "1.0.0",
  "description": "校园反诈卫士 - 大学生防骗指南小程序",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "data/**/*.js",
      "utils/**/*.js"
    ],
    "setupFilesAfterEnv": [
      "./test/setup.js"
    ]
  }
}
